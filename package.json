{
  "name": "plant-care",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test -w apps/mobile",
    "typecheck": "npm run typecheck -w apps/mobile",
    "lint": "npm run lint -w apps/mobile",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > apps/mobile/src/lib/database.types.ts"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "supabase": "^3.2.0"
  }
}
