# Local Supabase (values printed by `npm run db:start` / `npx supabase status`).
# Copy to .env.local. On a phone, replace 127.0.0.1 with your computer's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase status>

# Where Supabase sends people after they click the confirmation link.
EXPO_PUBLIC_EMAIL_CONFIRMED_URL=http://127.0.0.1:8081/email-confirmed
